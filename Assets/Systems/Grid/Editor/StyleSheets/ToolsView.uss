#tools-view {
	flex-direction: row;
	align-items: center;
	padding: 4px;
	background-color: rgba(102, 102, 102, 255);
}

#vector2int-field {
	flex-grow: 1;
}

#vector2int-field__label {
	display: none
}

#vector2int-field__fields-xField, #vector2int-field__fields-yField {
	width: 118px;
}

#tools-view-grid-text-label {
	align-self: stretch;
}

.tools-view-button {
	min-width: 35px;
	max-width: 35px;
	min-height: 35px;
	max-height: 35px;
}

#tools-view--left-options {
	flex-direction: column;
}

#tools-view--middle-options {
	flex-grow: 1;
	flex-direction: column;
	justify-content: center;
}

#tools-view--right-options {
	flex-direction: column;
	align-items: center;
	align-self: stretch;
	justify-content: space-around;
	max-width: 300px;
}

#tools-view-selector-parent {
	flex-direction: row;
}

#tools-view-grid-size-buttons-parent {
	padding-top: 4px;
	align-self: flex-start;
	flex-direction: row;
	align-items: center;
}

#tools-view-right-buttons-parent {
	flex-direction: row;
}
