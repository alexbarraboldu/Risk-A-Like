.abb-text-input-dialog {
	justify-content: space-between;
}

.abb-text-input-dialog__text-field {
	margin-top: 8px;
	margin-left: 8px;
	margin-right: 8px;
	align-self: stretch;
}

.abb-text-input-dialog__text-field > Label {
	min-width: 68px;
}

.abb-text-input-dialog__accept-button {
	margin-left: 8px;
	margin-right: 8px;
	margin-bottom: 8px;
	min-height: 30px;
	justify-content: center;
}

.abb-text-input-dialog__accept-button > Label {
	font-size: 18px;
}
