.text-input-dialog__root {
	justify-content: space-between;
}

TextField {
	margin-top: 8px;
	margin-left: 8px;
	margin-right: 8px;
	align-self: stretch;
}

TextField > Label {
	min-width: 68px;
}

Button {
	margin-left: 8px;
	margin-right: 8px;
	margin-bottom: 8px;
	min-height: 30px;
	justify-content: center;
}

Button > Label {
	font-size: 18px;
}
