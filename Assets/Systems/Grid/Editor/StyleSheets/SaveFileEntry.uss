.abb-save-file-entry {
	flex-direction: row;
	align-items: center;
	padding-left: 18px;
}

.abb-save-file-entry__icon {
	width: 16px;
	height: 16px;
	flex-shrink: 0;
}

.abb-save-file-entry__file-name {
	margin-left: 3px;
}

.abb-save-file-entry__delete-button {
	border-radius: 0px;
	border-width: 0px;
	align-self: stretch;
	margin: 0px;
	padding-left: 10px;
	padding-right: 10px;
}
