.abb-tools-view {
	flex-direction: row;
	align-items: center;
	padding: 4px;
	background-color: rgba(102, 102, 102, 255);
}

.abb-vector2-int-field {
	flex-grow: 1;
}

.abb-vector2-int-field__label {
	display: none
}

.abb-vector2-int-field #x-field, .abb-vector2-int-field #y-field {
	width: 118px;
}

.abb-tools-view__grid-name-label {
	align-self: stretch;
}

.abb-tools-view__button {
	min-width: 35px;
	max-width: 35px;
	min-height: 35px;
	max-height: 35px;
}

.abb-tools-view__editing-tools {
	flex-direction: column;
}

.abb-tools-view__spacer {
	flex-grow: 1;
	flex-direction: column;
	justify-content: center;
}

.abb-tools-view__file-tools {
	flex-direction: column;
	align-items: center;
	align-self: stretch;
	justify-content: space-around;
	max-width: 300px;
}

.abb-tools-view__color-selectors {
	flex-direction: row;
}

.abb-tools-view__grid-controls {
	padding-top: 4px;
	align-self: flex-start;
	flex-direction: row;
	align-items: center;
}

.abb-tools-view__file-actions {
	flex-direction: row;
}
