.abb-export-window__file-name-field {
	margin-left: 6px;
	margin-right: 6px;
	margin-top: 6px;
}

.abb-export-window__file-name-field > Label {
	min-width: 100px;
}

.abb-export-window__spacer {
	flex-grow: 0.5;
}

.abb-export-window__export-button {
	align-self: center;
	min-width: 100px;
	max-width: 100px;
	min-height: 100px;
	max-height: 100px;
	font-size: 24px;
}
