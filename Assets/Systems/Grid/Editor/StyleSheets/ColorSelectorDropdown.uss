.abb-color-selector-dropdown {
	flex-direction: row;
	flex-shrink: 0;
	margin-right: 3px;
}

.abb-color-selector-dropdown__color-field {
	width: 20px;
	height: 20px;
	margin-right: 0px;
	border-radius: 0px;
}

.abb-color-selector-dropdown__color-field > VisualElement {
	border-right-width: 0px;
	border-bottom-right-radius: 0px;
	border-top-right-radius: 0px;
}

#color-popup {
	max-width: 85px;
	min-width: 85px;
	height: 20px;
	margin-right: 0px;
	margin-left: 0px;
	border-left-width: 0px;
	border-bottom-left-radius: 0px;
	border-top-left-radius: 0px;
}

#color-popup > VisualElement {
	border-top-left-radius: 0px;
	border-bottom-left-radius: 0px;
}

#color-popup {
	background-color: #585858;
}

#color-popup:hover {
	background-color: #676767;
}

.abb-color-selector-dropdown > Button {
	padding: 0px;
	margin-right: 0px;
	min-width: 22px;
	min-height: 20px;
}

.abb-color-selector-dropdown > #add-color-button {
	border-right-width: 0px;
	border-bottom-right-radius: 0px;
	border-top-right-radius: 0px;
}

.abb-color-selector-dropdown > #remove-color-button {
	margin-left: 0px;
	border-bottom-left-radius: 0px;
	border-top-left-radius: 0px;
}

.abb-color-selector-dropdown #unity-internal-color-field {
	border-top-left-radius: 3px;
}

.abb-color-selector-dropdown ProgressBar .unity-progress-bar__progress {
	border-bottom-left-radius: 3px;
}

